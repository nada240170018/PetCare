<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvBackDetail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="← Detail Hewan"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="#354B40"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp"
            android:background="@drawable/bg_header_petcare">

            <TextView
                android:id="@+id/tvPetEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐱"
                android:textSize="85sp" />
            <ImageView
                android:id="@+id/ivPetPhoto"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Foto hewan" />

            <Button
                android:id="@+id/btnChoosePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Pilih Foto dari Galeri"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Hewan"
                android:textColor="#245B49"
                android:textSize="27sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sahabat kecil kesayanganmu 🐾"
                android:textColor="#527C6B"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informasi Hewan"
            android:textColor="#354B40"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jenis Hewan"
                android:textColor="#8B938B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetailType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#354B40"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ras Hewan"
                android:textColor="#8B938B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetailBreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#354B40"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Umur"
                android:textColor="#8B938B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetailAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#354B40"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berat Badan"
                android:textColor="#8B938B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetailWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#354B40"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
